# Copy this file to ".env" and edit it. NEVER commit ".env" to Git.

# ---- Embeddings ----
# "sentence-transformers" = real semantic search (downloads a ~90 MB model on first run)
# "hashing" = tiny offline demo embedder (no download; matches words, not meaning)
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- LLM ----
# "none" = retrieval-only mode (no API key needed)
# "openai_compatible" = any provider with an OpenAI-style API (see README)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2

# ---- Retrieval / chunking defaults (can also be changed in the app sidebar) ----
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
MIN_RELEVANCE=0.10

# ---- Optional: price per 1M tokens in USD, only used for cost ESTIMATES ----
# Look these up on your provider's pricing page. Leave 0 to skip cost estimates.
PRICE_INPUT_PER_M=0
PRICE_OUTPUT_PER_M=0
